<?xml version="1.0" encoding="UTF-8"?>
<!--
    Asymmetric demand scenario
    N-S corridor : ~600 vehicles/hour (heavy — exposes fixed-time signal failures)
    E-W corridor : ~100 vehicles/hour (light)
    Episode duration: 3600 s

    Per-flow breakdown:
      N-S straight : 280 veh/hr  (N->S and S->N)
      N turns      :  160 veh/hr total (80 each N->E, N->W)
      S turns      :  160 veh/hr total (80 each S->E, S->W)
      E-W straight :  40 veh/hr  (E->W and W->E)
      E turns      :  30 veh/hr total (15 each E->N, E->S)
      W turns      :  30 veh/hr total (15 each W->N, W->S)
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- ================================================================
         VEHICLE TYPE
         ================================================================ -->
    <vType id="passenger"
           accel="2.6"
           decel="4.5"
           length="5.0"
           maxSpeed="13.89"
           sigma="0.5"
           tau="1.0"
           minGap="2.5"
           color="1,0.5,0"/>

    <!-- ================================================================
         ROUTES
         ================================================================ -->
    <route id="r_N_S" edges="N_in S_out"/>
    <route id="r_N_E" edges="N_in E_out"/>
    <route id="r_N_W" edges="N_in W_out"/>

    <route id="r_S_N" edges="S_in N_out"/>
    <route id="r_S_E" edges="S_in E_out"/>
    <route id="r_S_W" edges="S_in W_out"/>

    <route id="r_E_W" edges="E_in W_out"/>
    <route id="r_E_N" edges="E_in N_out"/>
    <route id="r_E_S" edges="E_in S_out"/>

    <route id="r_W_E" edges="W_in E_out"/>
    <route id="r_W_N" edges="W_in N_out"/>
    <route id="r_W_S" edges="W_in S_out"/>

    <!-- ================================================================
         FLOWS — asymmetric: heavy N-S, light E-W
         ================================================================ -->

    <!-- From NORTH  (total ~600 veh/hr) -->
    <flow id="f_N_S" type="passenger" route="r_N_S" begin="0" end="3600" vehsPerHour="280" departLane="best" departSpeed="max"/>
    <flow id="f_N_E" type="passenger" route="r_N_E" begin="0" end="3600" vehsPerHour="160" departLane="best" departSpeed="max"/>
    <flow id="f_N_W" type="passenger" route="r_N_W" begin="0" end="3600" vehsPerHour="160" departLane="best" departSpeed="max"/>

    <!-- From SOUTH  (total ~600 veh/hr) -->
    <flow id="f_S_N" type="passenger" route="r_S_N" begin="0" end="3600" vehsPerHour="280" departLane="best" departSpeed="max"/>
    <flow id="f_S_E" type="passenger" route="r_S_E" begin="0" end="3600" vehsPerHour="160" departLane="best" departSpeed="max"/>
    <flow id="f_S_W" type="passenger" route="r_S_W" begin="0" end="3600" vehsPerHour="160" departLane="best" departSpeed="max"/>

    <!-- From EAST   (total ~100 veh/hr) -->
    <flow id="f_E_W" type="passenger" route="r_E_W" begin="0" end="3600" vehsPerHour="40"  departLane="best" departSpeed="max"/>
    <flow id="f_E_N" type="passenger" route="r_E_N" begin="0" end="3600" vehsPerHour="30"  departLane="best" departSpeed="max"/>
    <flow id="f_E_S" type="passenger" route="r_E_S" begin="0" end="3600" vehsPerHour="30"  departLane="best" departSpeed="max"/>

    <!-- From WEST   (total ~100 veh/hr) -->
    <flow id="f_W_E" type="passenger" route="r_W_E" begin="0" end="3600" vehsPerHour="40"  departLane="best" departSpeed="max"/>
    <flow id="f_W_N" type="passenger" route="r_W_N" begin="0" end="3600" vehsPerHour="30"  departLane="best" departSpeed="max"/>
    <flow id="f_W_S" type="passenger" route="r_W_S" begin="0" end="3600" vehsPerHour="30"  departLane="best" departSpeed="max"/>

</routes>
